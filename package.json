{
  "name": "ovrrun",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @ovrrun/client dev",
    "build": "pnpm -r build",
    "typecheck": "tsc -b --pretty",
    "lint": "eslint .",
    "test": "vitest run",
    "determinism": "vitest run --dir packages/sim/test --testNamePattern determinism",
    "bench": "node --experimental-strip-types tools/headless-bench/src/main.ts",
    "replay": "tsx tools/replay-diff/src/main.ts"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "eslint": "^9.13.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.11.0",
    "vite": "^5.4.9",
    "vitest": "^2.1.3",
    "tsx": "^4.19.0"
  }
}
